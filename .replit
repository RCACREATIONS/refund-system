modules = ["nodejs-24", "python-3.12"]
[nix]
channel = "stable-25_05"
packages = ["libxcrypt", "postgresql"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "backend_pid=; cleanup() { if [ -n \"$backend_pid\" ]; then kill \"$backend_pid\" 2>/dev/null || true; fi; }; trap 'cleanup; exit 143' TERM INT; trap cleanup EXIT; PYTHONPATH=backend python backend/run.py & backend_pid=$!; npm run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80


[[ports]]
localPort = 8000
externalPort = 8000
