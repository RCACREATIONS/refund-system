# Leave LLM_API_KEY empty to use the deterministic Mock AI mode.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
ADMIN_TOKEN=admin-demo-token

# Optional local database. The app falls back to in-memory mode when unset.
DATABASE_URL=postgresql://refunddesk:refunddesk@db:5432/refunddesk

# OpenAI-compatible presets:
# OpenAI: LLM_BASE_URL=https://api.openai.com/v1
# Groq: LLM_BASE_URL=https://api.groq.com/openai/v1
# Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Anthropic-compatible gateway: set the gateway URL here
# Ollama: LLM_BASE_URL=http://host.docker.internal:11434/v1
